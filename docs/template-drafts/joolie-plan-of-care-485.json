  "openItems": [
    "The near-empty draft “Joolie Health Plan of Care” (2 test fields, unused) is left untouched; delete it in the app if it is not needed."
  ],
  "textChanges": [
    {
      "template": "Home Health Certification and Plan of Care (CMS-485)",
      "from": "26. … and I have authorized on this plan of care …",
      "to": "… and I have authorized the services on this plan of care …",
      "reason": "Missing words (standard CMS-485 wording)"
    },
    {
      "template": "Home Health Certification and Plan of Care (CMS-485)",
      "from": "6. Patient’s Name and Address / 8. Date of Birth / 9. Sex",
      "to": "(omitted)",
      "reason": "The care plan is already attached to the client record"
    },
    {
      "template": "Home Health Certification and Plan of Care (CMS-485)",
      "from": "18.A / 18.B / 19 coded checkboxes (1, 2 … A, B)",
      "to": "Pick-any lists keeping each CMS code in the label",
      "reason": "Digital checkboxes"
    },
    {
      "template": "Home Health Certification and Plan of Care (CMS-485)",
      "from": "Items 26 and 28 (certification and penalty statements)",
      "to": "Shown as the description of the signature sections",
      "reason": "Care plan forms cannot show read-only text blocks"
    },
    {
      "template": "Home Health Certification and Plan of Care (CMS-485)",
      "from": "19. Mental Status: “Orientated”",
      "to": "“Oriented”",
      "reason": "Typo"
    }
  ],
