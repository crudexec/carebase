// BILLING ENUMS
// ============================================

enum BillingFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum UnitType {
  HOURLY // 1 unit = 1 hour
  QUARTER_HOURLY // 1 unit = 15 minutes
  DAILY // 1 unit = 1 day
}

enum BillingPeriodStatus {
  OPEN
  CLOSED
  SUBMITTED
  RECONCILED
}

enum ClaimStatus {
  DRAFT
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
  DENIED
  PAID
  PARTIALLY_PAID
}

enum SubmissionType {
  ORIGINAL
  CORRECTED
  VOID
}

enum SubmissionStatus {
  PENDING
  TRANSMITTED
  ACKNOWLEDGED
  ACCEPTED
  REJECTED
  ERROR
}

enum ClearinghouseType {
  GENERIC
  AVAILITY
  OFFICE_ALLY
}

enum FaxStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum FaxDirection {
  INBOUND
  OUTBOUND
}

