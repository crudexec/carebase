enum MedicationFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  EVERY_4_HOURS
  EVERY_6_HOURS
  EVERY_8_HOURS
  EVERY_12_HOURS
  WEEKLY
  MONTHLY
  AS_NEEDED_PRN
  BEFORE_MEALS
  AFTER_MEALS
