  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Navy primary action used for demo requests.",
      "html": "<a class=\"ds-primary\" href=\"#demo\">Book a demo <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-primary{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:16px;padding:14px 22px;background:#243c64;color:#fbf9f5;border:0;border-radius:6px;font-size:14px;font-weight:600;line-height:1.5;min-height:48px;text-decoration:none;transition:background .18s}.ds-primary:hover{background:#3a5684}.ds-primary:focus-visible{outline:3px solid #5273ad;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Text link",
      "kind": "button",
      "refersTo": "text-link",
      "description": "Secondary action with an underline revealed on hover.",
      "html": "<a class=\"ds-text-link\" href=\"#features\">Explore the platform <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-text-link{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#243c64;font-size:14px;font-weight:600;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:5px;transition:text-decoration-color .18s}.ds-text-link:hover{text-decoration-color:currentColor}.ds-text-link:focus-visible{outline:3px solid #5273ad;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-text-link{transition:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Labelled demo-request field with a distinct keyboard outline.",
      "html": "<label class=\"ds-field-label\" for=\"ds-work-email\">Work Email *</label><input class=\"ds-field\" id=\"ds-work-email\" type=\"email\" required autocomplete=\"email\" placeholder=\"john@company.com\" />",
      "css": ".ds-field-label{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:block;margin-bottom:6px;color:#243c64;font-size:12px;font-weight:500}.ds-field{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;width:100%;padding:11px 12px;border:1px solid #bbc6d8;background:#fffdf9;color:#243c64;border-radius:4px;font-size:13px;transition:border-color .15s}.ds-field::placeholder{color:#64718a;opacity:1}.ds-field:focus{border-color:#3d5f98;box-shadow:0 0 0 2px rgb(36 85 71 / 20%)}.ds-field:focus-visible{outline:2px solid #243c64;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Plain desktop section navigation on mist.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#features\">Platform</a><a href=\"#care\">Connected care</a><a href=\"#questions\">FAQs</a></nav>",
      "css": ".ds-nav{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:flex;align-items:center;gap:32px;height:96px;background:#e8edf7;color:#243c64;border-bottom:1px solid #bdc9df}.ds-nav a{font-size:14px;font-weight:500;color:inherit;text-decoration:none;text-underline-offset:5px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid #5273ad;outline-offset:5px;}@media(max-width:1100px){.ds-nav{gap:22px}}"
    },
    {
      "name": "Positive status",
      "kind": "chip",
      "refersTo": "status-positive",
      "description": "Informational status within an illustrative record.",
      "html": "<span class=\"ds-status\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 12 2 2 4-4\"/></svg>Signed</span>",
      "css": ".ds-status{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:inline-flex;align-items:center;gap:4px;font-size:9px;padding:4px 7px;border-radius:4px;white-space:nowrap;background:#e7eef9;color:#3b5682}"
    },
    {
      "name": "Neutral status",
      "kind": "chip",
      "refersTo": "status-neutral",
      "description": "Quiet secondary status within an illustrative record.",
      "html": "<span class=\"ds-status-neutral\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 12 2 2 4-4\"/></svg>Draft</span>",
      "css": ".ds-status-neutral{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:inline-flex;align-items:center;gap:4px;font-size:9px;padding:4px 7px;border-radius:4px;white-space:nowrap;background:#eeedf2;color:#60687b}"
    },
    {
      "name": "Illustrative record frame",
      "kind": "card",
      "refersTo": "preview-card",
      "description": "Tonal nested surfaces for a labelled product example.",
      "html": "<div class=\"ds-preview\"><div class=\"ds-preview-bar\"><strong>CareBase</strong><span>Illustrative example</span></div><div class=\"ds-preview-sheet\"><h4>One connected client record</h4><div class=\"ds-preview-row\">Care plan <span class=\"ds-preview-state\">Signed</span></div><div class=\"ds-preview-row\">Visit notes <span class=\"ds-preview-state\">Reviewed</span></div></div></div>",
      "css": ".ds-preview{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#e6ecf6;color:#243c64;border-radius:12px;padding:18px;font-size:12px}.ds-preview-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:1px 2px 18px}.ds-preview-bar strong{font-size:13px}.ds-preview-bar>span{font-size:10px;color:#59667c}.ds-preview-sheet{background:#fffdf9;padding:28px 25px;border-radius:6px}.ds-preview-sheet h4{font-family:Manrope,Arial,sans-serif;font-weight:700;font-size:23px;line-height:1.3;letter-spacing:-.025em;margin:8px 0 25px}.ds-preview-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 0;border-bottom:1px solid #e5e9f1;font-size:11px}.ds-preview-state{font-size:9px;padding:4px 7px;border-radius:4px;background:#e7eef9;color:#3b5682}"
    },
    {
      "name": "Feature tabs",
      "kind": "custom",
      "refersTo": "feature-tab",
      "description": "Visual states of the four-part explorer; production code owns keyboard selection and panel updates.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Explore CareBase features\"><button role=\"tab\" aria-selected=\"true\" tabindex=\"0\">Client &amp; clinical care</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Scheduling &amp; visits</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Billing &amp; oversight</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">People &amp; communication</button></div>",
